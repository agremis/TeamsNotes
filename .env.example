# Azure AD
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# LLM — provider: anthropic ou gemini
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-1.5-pro

# Open Brain — MCP server pessoal (captura automática do briefing diário como
# "thoughts" semânticas). Baseado no projeto OB1: https://github.com/NateBJones-Projects/OB1
# DESLIGADO por padrão — só ative se você já roda essa stack.
OPEN_BRAIN_SYNC_ENABLED=false
OPEN_BRAIN_MCP_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co/functions/v1/open-brain-mcp
OPEN_BRAIN_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# Config
DB_PATH=./storage/messages.db
BRIEFINGS_PATH=./briefings
OBSIDIAN_VAULT_PATH=C:\\Vault\\Projects\\Chats do Trabalho
CHATS_HTML_PATH=C:\\Vault\\Projects\\Chats do Trabalho\\CHATS
